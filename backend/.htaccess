# =============================================================
# BACKEND .htaccess — HOSTINGER SHARED PASSENGER NODE
# Domain: https://aliceblue-goose-490382.hostingersite.com
# Folder: /home/u695701224/domains/aliceblue-goose-490382.hostingersite.com/hbuilds/current/nodejs/
# (same folder as server.cjs + package.json)
#
# RULE #1: NO fancy directives that can trigger 403 Forbidden on Hostinger.
# RULE #2: NO <Files> / <DirectoryMatch> require-deny blocks that can break
#          Passenger startup file checks on shared hosting plans.
# RULE #3: NEVER early-return HTTP status (e.g. R=204) from Apache rewrite
#          rules without ALSO writing the Access-Control-Allow-Origin header
#          in the SAME htaccess pass. Browsers treat OPTIONS preflight as
#          CORS-fatal if any ACAO header is missing, even on a 204 "no body".
# =============================================================

# ------- (A) Auth & HTTPS passthrough -------
CGIPassAuth On
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RequestHeader set X-Forwarded-Proto "https"

# ------- (B) Disable Apache HTML error override (HIDDEN CORS FIX) -------
<IfModule mod_proxy.c>
  ProxyErrorOverride Off
</IfModule>
<IfModule LiteSpeed>
  ProxyErrorOverride Off
  LsapiDisableAdminCheck On
  LiteSpeed-Cache-Control no-cache
</IfModule>

# ------- (C) CORS HEADERS — ALWAYS-ON SAFETY NET, NO onsuccess UNSET -------
#
# PREVIOUS VERSION HAD A FATAL BUG: `Header onsuccess unset Access-Control-Allow-Origin`
# was also DELETING the CORS header Node.js had just written. In Apache:
#   * 2xx / 3xx responses live in the `onsuccess` table by default,
#   * `Header onsuccess unset X`  ->  DELETE any header X from that table,
#   * So even though server.cjs correctly called res.setHeader('ACAO'), the
#     .htaccess silently nuked it before Apache returned the response to the
#     browser → every browser read ACAO = null → CORS block on every call.
#
# Fix: DO NOT CALL `Header onsuccess unset ACAO/Methods/Headers` at all.
# Let Node (Passenger) write the authoritative values. Apache `always` table
# below only kicks in IF Apache short-circuits the request entirely (an error
# path, an OPTIONS that never reached Node). For normal Passenger responses,
# `always` headers do NOT overwrite an `onsuccess` one with the same name,
# so Node's echo-ed ACAO wins.
<IfModule mod_headers.c>
  Header always set X-Backend "node-express"
  Header always set Vary "Origin, Accept-Encoding, Referer"
  Header always set Access-Control-Allow-Methods "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS"
  Header always set Access-Control-Allow-Headers "Accept, Accept-Language, Authorization, Cache-Control, Content-Language, Content-Type, If-None-Match, Origin, X-Requested-With"
  Header always set Access-Control-Expose-Headers "Content-Disposition, X-Total-Count"
  Header always set Access-Control-Max-Age "86400"
  Header always set Access-Control-Allow-Credentials "false"

  # Dynamic ACAO via SetEnvIf + regex capture. Covers entertainment-trends.com
  # (http/https, naked/www), the Hostinger backend subdomain, localhost dev
  # origins (any port), and Origin: null (sandboxed iframes).
  SetEnvIf Origin "^(https?://(?:www\.)?entertainment-trends\.com)$" CORS_ACAO=$0
  SetEnvIf Origin "^(https?://(?:www\.)?entertainment-trends\.com:[0-9]+)$" CORS_ACAO=$0
  SetEnvIf Origin "^(https?://aliceblue-goose-490382\.hostingersite\.com)$" CORS_ACAO=$0
  SetEnvIf Origin "^(https?://aliceblue-goose-490382\.hostingersite\.com:[0-9]+)$" CORS_ACAO=$0
  SetEnvIf Origin "^(https?://(localhost|127\.0\.0\.1|0\.0\.0\.0)(:[0-9]+)?)$" CORS_ACAO=$0
  SetEnvIf Origin "^null$" CORS_ACAO=$0
  Header always set Access-Control-Allow-Origin "%{CORS_ACAO}e" env=CORS_ACAO

  # Referer-based fallback: if Hostinger stripped the Origin header before
  # Passenger (observed behaviour on some shared plans), the Referer still
  # shows the real frontend host and we can mirror ACAO to the public domain.
  SetEnvIf Referer "^https?://(?:www\.)?entertainment-trends\.com/" CORS_REF_OK=1
  Header always set Access-Control-Allow-Origin "https://entertainment-trends.com" env=CORS_REF_OK

  # Ensure Node-level ACAO that gets echoed on Passenger responses is NEVER
  # overwritten by a stale/empty capture from the always table. If ACAO was
  # already written into the onsuccess table by Node, we MERGE by doing
  # nothing here — `Header always set` won't duplicate the onsuccess value.
</IfModule>

# ------- (D) OPTIONS preflight — forwarded to Passenger (Node answers 204)
# Apache's Section (C) already adds Access-Control-Allow-Origin for any
# Apache-short-circuited response. Real OPTIONS reach Node and get a proper
# Node-level 204 with the same headers. No early R=204 here — we've seen it
# cause missing ACAO headers on different Hostinger plans.

# ------- (E) Passenger app declaration — ONLY what Hostinger uses -------
PassengerAppRoot /home/u695701224/domains/aliceblue-goose-490382.hostingersite.com/hbuilds/current/nodejs
PassengerAppType node
PassengerNodejs /opt/alt/alt-nodejs24/root/bin/node
PassengerStartupFile server.cjs
PassengerBaseURI /

# ------- (F) Node / Hostinger env -------
SetEnv LSNODE_CONSOLE_LOG console.log
SetEnv NODE_ENV production

# ------- (G) ONLY the safest possible deny lines — hidden files + .env -------
<FilesMatch "^\..*$">
  Require all denied
</FilesMatch>

Options -Indexes -MultiViews
